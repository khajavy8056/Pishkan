root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.ps1]
# Windows PowerShell 5.1 needs a UTF-8 BOM to read Persian text correctly.
charset = utf-8-bom
end_of_line = crlf
indent_size = 2

[*.cmd]
# cmd.exe needs CRLF and pure ASCII (see windows/lib/ps-lint.mjs).
charset = latin1
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
