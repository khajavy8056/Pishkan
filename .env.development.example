# Local development only. Never use these values on a public deployment.
NODE_ENV=development
DB_DRIVER=sqlite
SQLITE_FILE=./.data/pishkan.db
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false
APP_ENCRYPTION_KEY=development-only-key-do-not-use-in-production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
DEMO_MODE=false
