# ---------------------------------------------------------------------------
# Pishkan environment template. Copy to .env and fill in real values.
# The Linux installer generates this file with random secrets automatically.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database: postgres (production) or sqlite (local dev / CI only)
DB_DRIVER=postgres
DATABASE_URL=postgres://pishkan:CHANGE_ME@127.0.0.1:5432/pishkan
# SQLITE_FILE=./.data/pishkan.db

# Public addresses (used for absolute links in SMS/email)
APP_URL=https://pishkan.example.ir
API_URL=https://pishkan.example.ir
CORS_ORIGINS=https://pishkan.example.ir
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_COOKIE=pishkan_session
SESSION_TTL_HOURS=168

# 32+ characters, generated by the installer. Used to encrypt integration keys at rest.
APP_ENCRYPTION_KEY=

# Storage
UPLOAD_DIR=/var/lib/pishkan/uploads
BACKUP_DIR=/var/backups/pishkan

# First super-admin (created only if no admin exists)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=مدیر سامانه
BOOTSTRAP_ADMIN_MOBILE=

# Runtime
LOG_LEVEL=info
LOG_FILE=/var/log/pishkan/api.log
DEMO_MODE=false
APP_VERSION=1.0.0
