{
  "problemMatcher": [
    {
      "owner": "dart-analyze",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*(error|warning|info)\\s*•\\s*(.+)\\s*•\\s*([^:]+):(\\d+):(\\d+)\\s*•\\s*([a-z_]+)\\s*$",
          "severity": 1,
          "message": 2,
          "file": 3,
          "line": 4,
          "column": 5,
          "code": 6
        }
      ]
    }
  ]
}
