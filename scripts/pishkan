#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pishkan — lifecycle management for a Pishkan installation
#
#   pishkan status | health | version
#   pishkan logs [api|nginx] [-f]
#   pishkan restart
#   pishkan update [--ref <40-char-commit-SHA>] [--no-backup]
#   pishkan rollback [--to <release-id>]
#   pishkan backup [--dest <dir>] [--quiet]
#   pishkan restore <backup-file> [--yes]
#   pishkan migrate | seed [--catalog-only] | reset-admin
#   pishkan doctor
#
# Customer, invoice, transaction, settings and administrator data are never
# deleted by update/rollback/migrate. Only `restore` replaces data, and it
# requires an explicit typed confirmation plus a pre-restore safety backup.
# ---------------------------------------------------------------------------

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SCRIPT_DIR}/lib/common.sh" ]; then
  # shellcheck source=lib/common.sh
  . "${SCRIPT_DIR}/lib/common.sh"
  # shellcheck source=lib/config.sh
  . "${SCRIPT_DIR}/lib/config.sh"
  # shellcheck source=lib/net.sh
  . "${SCRIPT_DIR}/lib/net.sh"
else
  # shellcheck source=/dev/null
  . /opt/pishkan/current/scripts/lib/common.sh
  # shellcheck source=/dev/null
  . /opt/pishkan/current/scripts/lib/config.sh
  # shellcheck source=/dev/null
  . /opt/pishkan/current/scripts/lib/net.sh
fi

BACKUP_KEEP_DAYS="${BACKUP_KEEP_DAYS:-14}"

usage() {
  cat <<'EOF'
سامانه پشکان — مدیریت نصب

  pishkan status                 وضعیت سرویس، نسخه و سلامت API
  pishkan health                 بررسی سلامت (کد خروج ۰ یعنی سالم)
  pishkan version                نسخه نصب‌شده و شناسه نسخه (commit)
  pishkan logs [api|nginx] [-f]  مشاهده لاگ‌ها
  pishkan restart                راه‌اندازی مجدد سرویس API
  pishkan update [--ref SHA]     به‌روزرسانی از commit کامل تأییدشده؛ در خطا بازمی‌گردد
  pishkan provision [--tls]      اعمال دوبارهٔ deploy.conf روی nginx، TLS و تنظیمات
  pishkan rollback [--to ID]     بازگشت به نسخه قبلی
  pishkan backup [--dest DIR]    پشتیبان‌گیری از پایگاه داده و مدارک
  pishkan restore FILE [--yes]   بازیابی (نیازمند تأیید صریح)
  pishkan migrate                اجرای مهاجرت‌های نسخه‌بندی‌شده
  pishkan seed [--catalog-only]  بارگذاری/به‌روزرسانی کاتالوگ نمونه
  pishkan reset-admin            رمز جدید برای مدیر کل (نمایش یک‌باره)
  pishkan doctor                 بررسی کامل پیش‌نیازها و تنظیمات
EOF
}

cmd_version() {
  if ! is_installed; then
    err "Pishkan روی این سرور نصب نشده است."
    exit 1
  fi
  local release version commit
  release="$(current_release)"
  version="$(read_env_value APP_VERSION)"
  commit="$(cat "${release}/.release-commit" 2>/dev/null || git -C "$release" rev-parse --short HEAD 2>/dev/null || echo 'نامشخص')"
  printf 'Pishkan %s\nنسخه فعال: %s\nشناسه نسخه: %s\nمسیر: %s\n' "${version:-?}" "$(basename "$release")" "$commit" "$release"
}

cmd_health() {
  local url
  url="$(health_url)"
  if ! command -v curl >/dev/null 2>&1; then
    err "curl نصب نیست؛ بررسی سلامت ممکن نیست."
    return 1
  fi
  local response
  if response="$(curl -fsS --max-time 5 "$url")"; then
    ok "API سالم است: $url"
    printf '%s\n' "$response"
    return 0
  fi
  err "API پاسخ سالم نداد: $url"
  return 1
}

cmd_status() {
  heading "وضعیت سامانه پشکان"
  cmd_version || true
  echo
  if service_active; then ok "سرویس ${SERVICE_NAME}: فعال"; else err "سرویس ${SERVICE_NAME}: غیرفعال"; fi
  systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null && ok "راه‌اندازی خودکار: فعال" || warn "راه‌اندازی خودکار: غیرفعال"
  echo
  if command -v nginx >/dev/null 2>&1; then
    if systemctl is-active --quiet nginx; then ok "Nginx: فعال"; else err "Nginx: غیرفعال"; fi
  fi
  if command -v psql >/dev/null 2>&1; then
    if systemctl is-active --quiet postgresql; then ok "PostgreSQL: فعال"; else err "PostgreSQL: غیرفعال"; fi
  fi
  echo
  cmd_health || true
  echo
  local backup_count latest
  backup_count="$(find "$BACKUP_DIR" -maxdepth 1 -name 'pishkan-backup-*.tar.gz' 2>/dev/null | wc -l | tr -d ' ')"
  latest="$(ls -1t "${BACKUP_DIR}"/pishkan-backup-*.tar.gz 2>/dev/null | head -1 || true)"
  if [ -n "$latest" ]; then
    ok "پشتیبان‌ها: ${backup_count} نسخه • آخرین: $(basename "$latest") ($(date -r "$latest" '+%Y-%m-%d %H:%M'))"
  else
    warn "هیچ نسخه پشتیبانی ایجاد نشده است. «pishkan backup» را اجرا کنید."
  fi
  if systemctl is-active --quiet pishkan-backup.timer 2>/dev/null; then
    ok "پشتیبان‌گیری خودکار: فعال (روزانه ۰۲:۳۰)"
  else
    warn "پشتیبان‌گیری خودکار: غیرفعال (systemctl enable --now pishkan-backup.timer)"
  fi
}

cmd_logs() {
  local target="api" follow=0
  for arg in "$@"; do
    case "$arg" in
      -f|--follow) follow=1 ;;
      api|nginx) target="$arg" ;;
      *) die "پارامتر نامعتبر برای logs: $arg" ;;
    esac
  done
  case "$target" in
    nginx) if [ "$follow" = "1" ]; then journalctl -u nginx -f; else journalctl -u nginx -n 100 --no-pager; fi ;;
    api|""|"*") if [ "$follow" = "1" ]; then journalctl -u "$SERVICE_NAME" -f
               else journalctl -u "$SERVICE_NAME" -n 150 --no-pager; fi ;;
    *) die "هدف لاگ نامعتبر است. از api یا nginx استفاده کنید." ;;
  esac
}

cmd_restart() {
  require_root
  log "راه‌اندازی مجدد ${SERVICE_NAME}…"
  systemctl restart "$SERVICE_NAME"
  if wait_for_health 60; then ok "سرویس با موفقیت راه‌اندازی شد."; else die "سرویس پس از راه‌اندازی پاسخ نداد. journalctl -u ${SERVICE_NAME} -n 100"; fi
}

# ---------------------------------------------------------------------------
# backup / restore
# ---------------------------------------------------------------------------

cmd_backup() {
  local quiet=0 dest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet) quiet=1 ;;
      --dest) shift; dest="${1:-}" ;;
      *) die "پارامتر ناشناخته برای backup: $1" ;;
    esac
    shift
  done
  dest="${dest:-$BACKUP_DIR}"
  mkdir -p "$dest"

  local stamp file workdir driver database_file database_checksum uploads_checksum
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  file="${dest}/pishkan-backup-${stamp}.tar.gz"
  workdir="$(mktemp -d)"
  driver="$(read_env_value DB_DRIVER)"

  [ "$quiet" = "1" ] || log "پشتیبان‌گیری از پایگاه داده (${driver:-postgres})…"
  if [ "$driver" = "sqlite" ]; then
    database_file="database.sqlite"
    local sqlite_file
    sqlite_file="$(read_env_value SQLITE_FILE)"
    [ -f "$sqlite_file" ] || die "فایل SQLite یافت نشد: ${sqlite_file:-تنظیم نشده}"
    # Use the SQLite backup-safe copy: dump via sqlite3 when available.
    if command -v sqlite3 >/dev/null 2>&1; then
      sqlite3 "$sqlite_file" ".backup '${workdir}/database.sqlite'"
    else
      die 'sqlite3 نصب نیست؛ کپی خام دیتابیس زنده ناامن است و پشتیبان‌گیری لغو شد.'
    fi
  else
    database_file="database.dump"
    PGPASSWORD="$(read_env_value DB_PASSWORD)" pg_dump \
      --host "$DB_HOST" --port "$DB_PORT" --username "$DB_USER" --dbname "$DB_NAME" \
      --format=custom --no-owner --no-privileges --file "${workdir}/${database_file}"
  fi

  [ "$quiet" = "1" ] || log "پشتیبان‌گیری از مدارک و فایل‌ها…"
  mkdir -p "$UPLOAD_DIR"
  tar -C "$UPLOAD_DIR" -czf "${workdir}/uploads.tar.gz" . || die "آرشیو مدارک ناقص است؛ پشتیبان‌گیری ناموفق بود."
  database_checksum="$(sha256sum "${workdir}/${database_file}" | awk '{print $1}')"
  uploads_checksum="$(sha256sum "${workdir}/uploads.tar.gz" | awk '{print $1}')"

  cat >"${workdir}/manifest.json" <<EOF
{
  "createdAt": "${stamp}",
  "appVersion": "$(read_env_value APP_VERSION)",
  "commit": "$(cat "$(current_release)/.release-commit" 2>/dev/null || echo unknown)",
  "driver": "${driver:-postgres}",
  "database": "${DB_NAME}",
  "databaseFile": "${database_file}",
  "databaseChecksum": "${database_checksum}",
  "uploadsFile": "uploads.tar.gz",
  "uploadsChecksum": "${uploads_checksum}",
  "release": "$(basename "$(current_release)")",
  "hostname": "$(hostname)"
}
EOF

  tar -C "$workdir" -czf "$file" .
  sha256sum "$file" >"${file}.sha256"
  chmod 0600 "$file" "${file}.sha256"
  rm -rf "$workdir"

  [ "$quiet" = "1" ] || ok "نسخه پشتیبان ساخته شد: $file ($(du -h "$file" | cut -f1))"

  # Retention is local-only; long-term copies must live off the server.
  find "$dest" -maxdepth 1 -name 'pishkan-backup-*.tar.gz' -mtime "+${BACKUP_KEEP_DAYS}" -delete 2>/dev/null || true
  find "$dest" -maxdepth 1 -name 'pishkan-backup-*.tar.gz.sha256' -mtime "+${BACKUP_KEEP_DAYS}" -delete 2>/dev/null || true

  if [ "$quiet" != "1" ]; then
    warn "این نسخه روی همان سرور است. برای محافظت واقعی، آن را به مقصد خارج از سرور منتقل کنید:"
    warn "  rsync -av ${file}* backup-host:/backups/pishkan/    یا    rclone copy ${file}* remote:pishkan"
  fi
}

safe_extract() {
  command -v python3 >/dev/null 2>&1 || die "python3 برای اعتبارسنجی آرشیو لازم است."
  python3 - "$1" "$2" <<'PYARCHIVE'
import pathlib, shutil, sys, tarfile
archive, target = sys.argv[1:]
root = pathlib.Path(target).resolve()
root.mkdir(parents=True, exist_ok=True)
with tarfile.open(archive, 'r:gz') as tar:
    for member in tar.getmembers():
        if not (member.isfile() or member.isdir()):
            raise SystemExit('Links and special archive members are forbidden')
        dest = (root / member.name).resolve()
        try: dest.relative_to(root)
        except ValueError: raise SystemExit('Unsafe archive member: extraction aborted')
        if member.isdir():
            dest.mkdir(parents=True, exist_ok=True)
        else:
            dest.parent.mkdir(parents=True, exist_ok=True)
            source = tar.extractfile(member)
            if source is None: raise SystemExit('Unreadable archive member')
            with source, dest.open('wb') as output: shutil.copyfileobj(source, output)
PYARCHIVE
}

cmd_restore() {
  require_root
  local file="" assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1 ;;
      -*) die "پارامتر ناشناخته: $1" ;;
      *) file="$1" ;;
    esac
    shift
  done
  [ -n "$file" ] || die "مسیر فایل پشتیبان را وارد کنید: pishkan restore /var/backups/pishkan/pishkan-backup-…tar.gz"
  [ -f "$file" ] || die "فایل پشتیبان یافت نشد: $file"

  if [ -f "${file}.sha256" ]; then
    log "بررسی صحت فایل پشتیبان…"
    ( cd "$(dirname "$file")" && sha256sum -c "$(basename "$file").sha256" >/dev/null ) \
      || die "چک‌سام مطابقت ندارد. فایل پشتیبان ناقص یا تغییر یافته است."
    ok "چک‌سام تأیید شد."
  else
    die "فایل چک‌سام یافت نشد؛ بازیابی بدون تأیید صحت مجاز نیست."
  fi

  warn "بازیابی، داده‌های فعلی (مشتریان، فاکتورها، تراکنش‌ها، تنظیمات) را با محتوای این نسخه جایگزین می‌کند."
  if [ "$assume_yes" != "1" ]; then
    confirm_phrase RESTORE "برای ادامه عبارت RESTORE را تایپ کنید: " || die "بازیابی لغو شد."
  fi

  local workdir driver upload_previous
  workdir="$(mktemp -d)"
  safe_extract "$file" "$workdir" || { rm -rf "$workdir"; die "استخراج امن فایل پشتیبان ناموفق بود."; }
  [ -f "${workdir}/manifest.json" ] || { rm -rf "$workdir"; die "ساختار فایل پشتیبان معتبر نیست."; }
  if [ ! -f "${workdir}/database.dump" ] && [ ! -f "${workdir}/database.sqlite" ]; then
    rm -rf "$workdir"; die "فایل پایگاه داده در نسخه پشتیبان موجود نیست."
  fi
  [ -f "${workdir}/uploads.tar.gz" ] || { rm -rf "$workdir"; die "آرشیو مدارک به این نسخه پشتیبان پیوست نیست؛ بازیابی کامل لغو شد."; }
  python3 - "${workdir}/manifest.json" "$workdir" <<'PYMANIFEST' || { rm -rf "$workdir"; die "manifest یا checksum اجزای پشتیبان معتبر نیست."; }
import hashlib, json, pathlib, sys
manifest_path, root = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
database = manifest.get('databaseFile') or ('database.dump' if (root / 'database.dump').exists() else 'database.sqlite')
uploads = manifest.get('uploadsFile') or 'uploads.tar.gz'
if database not in ('database.dump', 'database.sqlite') or uploads != 'uploads.tar.gz':
    raise SystemExit('Unexpected component filename')
for filename, key in ((database, 'databaseChecksum'), (uploads, 'uploadsChecksum')):
    expected = manifest.get(key)
    if expected is not None:
        if len(expected) != 64 or any(ch not in '0123456789abcdef' for ch in expected.lower()):
            raise SystemExit('Malformed checksum')
        digest = hashlib.sha256()
        with (root / filename).open('rb') as component:
            for chunk in iter(lambda: component.read(1024 * 1024), b''): digest.update(chunk)
        if digest.hexdigest().lower() != expected.lower(): raise SystemExit('Component checksum mismatch')
PYMANIFEST
  mkdir -p "${workdir}/uploads-stage"
  safe_extract "${workdir}/uploads.tar.gz" "${workdir}/uploads-stage" || { rm -rf "$workdir"; die "استخراج امن مدارک ناموفق بود؛ هیچ داده‌ای جایگزین نشد."; }

  log "ایجاد نسخه پشتیبان ایمنی از وضعیت فعلی…"
  cmd_backup --quiet || { rm -rf "$workdir"; die "ایجاد نسخه ایمنی ناموفق بود؛ بازیابی لغو شد."; }

  driver="$(read_env_value DB_DRIVER)"
  if [ -f "${workdir}/database.dump" ]; then
    log "بازیابی پایگاه داده…"
    systemctl stop "$SERVICE_NAME" || die "توقف سرویس ناموفق بود؛ بازیابی لغو شد."
    PGPASSWORD="$(read_env_value DB_PASSWORD)" pg_restore \
      --host "$DB_HOST" --port "$DB_PORT" --username "$DB_USER" --dbname "$DB_NAME" \
      --single-transaction --exit-on-error --clean --if-exists --no-owner --no-privileges "${workdir}/database.dump" \
      || die "pg_restore ناموفق بود؛ تراکنش بازیابی برگشت داده شد و سرویس متوقف است. از پشتیبان ایمنی استفاده کنید."
  elif [ -f "${workdir}/database.sqlite" ]; then
    log "بازیابی پایگاه داده SQLite…"
    systemctl stop "$SERVICE_NAME" || die "توقف سرویس ناموفق بود؛ بازیابی لغو شد."
    local sqlite_target
    sqlite_target="$(read_env_value SQLITE_FILE)"
    rm -f "${sqlite_target}-wal" "${sqlite_target}-shm"
    cp "${workdir}/database.sqlite" "$sqlite_target"
    chown "$APP_USER:$APP_GROUP" "$sqlite_target"
    chmod 0600 "$sqlite_target"
  else
    rm -rf "$workdir"
    die "پایگاه داده‌ای در فایل پشتیبان یافت نشد."
  fi

  log "جایگزینی آرشیو مدارک با نسخه بررسی‌شده…"
  mkdir -p "$(dirname "$UPLOAD_DIR")"
  upload_previous="${UPLOAD_DIR}.pre-restore-$(date -u +%Y%m%d%H%M%S)-$$"
  if [ -e "$UPLOAD_DIR" ] || [ -L "$UPLOAD_DIR" ]; then mv "$UPLOAD_DIR" "$upload_previous"; fi
  if ! mv "${workdir}/uploads-stage" "$UPLOAD_DIR"; then
    [ ! -e "$upload_previous" ] || mv "$upload_previous" "$UPLOAD_DIR"
    rm -rf "$workdir"
    die "جایگزینی آرشیو مدارک انجام نشد؛ نسخه پایگاه داده ایمنی ${BACKUP_DIR} حفظ شده است."
  fi
  chown -R "$APP_USER:$APP_GROUP" "$UPLOAD_DIR"
  rm -rf "$workdir"

  systemctl start "$SERVICE_NAME"
  if wait_for_health 90; then
    [ ! -e "$upload_previous" ] || rm -rf "$upload_previous"
    ok "بازیابی پایگاه داده و آرشیو مدارک با موفقیت انجام شد."
  else
    die "سرویس پس از بازیابی پاسخ نداد. نسخه ایمنی در ${BACKUP_DIR} و فایل مدارک قبلی در ${upload_previous} حفظ شده است."
  fi
  [ "$driver" = "sqlite" ] && warn "در محیط SQLite، لاگ‌های WAL ممکن است نیاز به راه‌اندازی مجدد داشته باشند."
  return 0
}

# ---------------------------------------------------------------------------
# update / rollback
# ---------------------------------------------------------------------------

# Resolve the newest commit on the tracking branch, without cloning the whole
# repository history. `git ls-remote` is a single round trip and needs no
# workspace, which is what makes `pishkan update` usable with no arguments.
resolve_remote_branch_commit() {
  local branch="${1:-$REPO_BRANCH}" out
  out="$(git ls-remote --heads "$REPO_URL" "refs/heads/${branch}" 2>/dev/null | awk '{print $1; exit}')"
  if ! is_full_commit "$out"; then
    return 1
  fi
  printf '%s' "$out"
}

# Delete old releases, keeping the newest KEEP_RELEASES plus the one `previous`
# points at. Running out of disk is the failure that makes the *next* update
# fail, and it is always discovered too late, so this runs after every
# successful update rather than on a schedule.
prune_releases() {
  local keep="${1:-5}" protected name removed=0
  protected="$(readlink -f "${APP_ROOT}/previous" 2>/dev/null | xargs -r basename 2>/dev/null || true)"

  [ -d "$RELEASES_DIR" ] || return 0

  local -a all
  mapfile -t all < <(find "$RELEASES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)

  local total=${#all[@]}
  [ "$total" -gt "$keep" ] || return 0

  local to_remove=$((total - keep))
  for name in "${all[@]}"; do
    [ "$to_remove" -gt 0 ] || break
    [ "$name" = "$protected" ] && continue
    [ "$name" = "$(readlink -f "$CURRENT_LINK" 2>/dev/null | xargs -r basename 2>/dev/null)" ] && continue
    rm -rf "${RELEASES_DIR:?}/${name}"
    removed=$((removed + 1))
    to_remove=$((to_remove - 1))
  done
  [ "$removed" -gt 0 ] && log "${removed} نسخه قدیمی حذف شد (نگه‌داشتن ${keep} نسخهٔ آخر)."
  return 0
}

cmd_update() {
  require_root
  local ref="" no_backup=0 dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --ref) shift; ref="${1:-}" ;;
      --no-backup) no_backup=1 ;;
      --dry-run) dry_run=1 ;;
      *) die "پارامتر ناشناخته برای update: $1" ;;
    esac
    shift
  done

  is_installed || die "Pishkan نصب نشده است."

  # With no --ref, look up the branch tip. An explicit PISHKAN_COMMIT still
  # wins, so the piped installer examples keep working unchanged.
  if [ -z "$ref" ]; then
    ref="${PISHKAN_COMMIT:-}"
  fi
  if [ -z "$ref" ]; then
    log "بررسی مخزن برای نسخهٔ تازه…"
    ref="$(resolve_remote_branch_commit "$REPO_BRANCH" || true)"
    if ! is_full_commit "$ref"; then
      die "دریافت آخرین نسخه از مخزن ناموفق بود. اتصال شبکه یا دسترسی مخزن را بررسی کنید."
    fi
  fi

  is_full_commit "$ref" || die 'به‌روزرسانی فقط با SHA کامل ۴۰ رقمی commit مجاز است: pishkan update --ref <SHA>'

  local old_release new_dir commit old_commit
  old_release="$(current_release)"
  old_commit="$(read_env_value PISHKAN_RELEASE_REF)"

  if [ "${ref,,}" = "${old_commit,,}" ]; then
    ok "نسخهٔ نصب‌شده همین ${ref:0:12} است؛ چیزی برای به‌روزرسانی نیست."
    return 0
  fi

  if [ "$dry_run" = "1" ]; then
    heading "بررسی به‌روزرسانی (آزمایشی)"
    echo "  نسخه فعلی:   ${old_commit:0:12}"
    echo "  نسخه تازه:   ${ref:0:12}"
    echo "  پشتیبان:     $(config_get BACKUP_ENABLED true | sed 's/true/بله/;s/false/خیر/')"
    echo "  نسخه‌های نگه‌داشته: $(config_get KEEP_RELEASES 5)"
    echo
    log "هیچ تغییری اعمال نشد. برای اجرا: sudo pishkan update"
    return 0
  fi

  new_dir="${RELEASES_DIR}/$(date -u +%Y%m%d%H%M%S)"

  heading "به‌روزرسانی پشکان (${ref})"
  if [ "$no_backup" != "1" ]; then
    log "پشتیبان‌گیری پیش از به‌روزرسانی…"
    cmd_backup --quiet || die "پشتیبان‌گیری ناموفق بود؛ به‌روزرسانی متوقف شد."
  else
    warn "پشتیبان‌گیری پیش از به‌روزرسانی با درخواست شما رد شد."
  fi

  log "دریافت commit تأییدشده…"
  commit="$(clone_verified_commit "$ref" "$new_dir")"
  printf '%s\n' "$commit" >"${new_dir}/.release-commit"
  chown -R "$APP_USER:$APP_GROUP" "$new_dir"
  ok "نسخه جدید: $commit"

  log "نصب وابستگی‌ها و ساخت…"
  run_as_app "$new_dir" npm ci --no-audit --no-fund >/dev/null

  local failed=0
  run_as_app "$new_dir" npm run build --workspace apps/api >/dev/null || failed=1
  run_as_app "$new_dir" npm run build --workspace apps/web >/dev/null || failed=1
  if [ "$failed" = "1" ]; then
    err "ساخت نسخه جدید ناموفق بود. نسخه فعلی دست‌نخورده باقی ماند."
    rm -rf "$new_dir"
    exit 1
  fi

  log "اجرای مهاجرت‌ها…"
  if ! run_cli_script "$new_dir" migrate; then
    err "مهاجرت ناموفق بود. نسخه فعلی حفظ شد (داده‌ها تغییر نکردند)."
    rm -rf "$new_dir"
    exit 1
  fi

  log "فعال‌سازی نسخه جدید…"
  ln -sfn "$old_release" "${APP_ROOT}/previous"
  ln -sfn "$new_dir" "$CURRENT_LINK"
  install -m 0644 "${CURRENT_LINK}/deploy/systemd/pishkan-api.service" "/etc/systemd/system/${SERVICE_NAME}.service"
  systemctl daemon-reload
  systemctl restart "$SERVICE_NAME"

  if wait_for_health 90; then
    set_env_value PISHKAN_RELEASE_REF "$commit"
    ok "به‌روزرسانی انجام شد (commit تأییدشده ${commit})."
    install -m 0755 "${CURRENT_LINK}/scripts/pishkan" /usr/local/bin/pishkan
    install -m 0644 "${CURRENT_LINK}/deploy/systemd/pishkan-backup.service" /etc/systemd/system/ 2>/dev/null || true

    # A new release may change the nginx template itself (a new header, a new
    # cache rule, a fixed ACME block). Re-provisioning after the switch is what
    # makes those changes reach the running config; without it, template edits
    # only take effect on a fresh install and drift silently forever.
    if [ -f "${CONFIG_DIR}/deploy.conf" ]; then
      log "اعمال تنظیمات استقرار روی نسخه جدید…"
      if cmd_provision >/dev/null 2>&1; then
        ok "پیکربندی Nginx و TLS با نسخه جدید هم‌راستا شد."
      else
        warn "بازاعمال تنظیمات استقرار ناموفق بود؛ سایت با تنظیمات قبلی کار می‌کند."
        warn "  برای بررسی: sudo pishkan provision"
      fi
    fi

    # Old releases are what fill the disk and, eventually, break an update.
    prune_releases "$(config_get KEEP_RELEASES 5)"
  else
    err "سرویس جدید سالم نبود؛ بازگشت به نسخه قبلی…"
    ln -sfn "$old_release" "$CURRENT_LINK"
    systemctl restart "$SERVICE_NAME"
    if wait_for_health 60; then
      err "بازگشت انجام شد. نسخه جدید در ${new_dir} برای بررسی باقی ماند."
    else
      err "بازگشت خودکار ناموفق بود. بررسی دستی لازم است: journalctl -u ${SERVICE_NAME} -n 200"
    fi
    exit 1
  fi
}

cmd_rollback() {
  require_root
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) shift; target="${1:-}" ;;
      *) die "پارامتر ناشناخته برای rollback: $1" ;;
    esac
    shift
  done
  is_installed || die "Pishkan نصب نشده است."

  [ -n "$target" ] || target="$(previous_release)"
  [ -n "$target" ] || die "نسخه قبلی موجود نیست."
  local target_dir="${RELEASES_DIR}/${target}"
  [ -d "$target_dir" ] || die "نسخه ${target} یافت نشد."

  warn "بازگشت به نسخه ${target}. پایگاه داده بازگردانی نمی‌شود؛ فقط کد تغییر می‌کند."
  warn "اگر نسخه جدید مهاجرت داده انجام داده باشد، ممکن است کد قدیمی با ساختار جدید سازگار نباشد."
  confirm_phrase ROLLBACK "برای ادامه عبارت ROLLBACK را تایپ کنید: " || die "بازگشت لغو شد."

  ln -sfn "$(current_release)" "${APP_ROOT}/previous"
  ln -sfn "$target_dir" "$CURRENT_LINK"
  systemctl restart "$SERVICE_NAME"
  if wait_for_health 60; then ok "بازگشت به ${target} انجام شد."; else die "سرویس پاسخ نداد؛ journalctl را بررسی کنید."; fi
}

# ---------------------------------------------------------------------------
# maintenance helpers
# ---------------------------------------------------------------------------

cmd_migrate() {
  require_root
  local release
  release="$(current_release)"
  is_installed || die "Pishkan نصب نشده است."
  run_cli_script "$release" migrate
  ok "مهاجرت‌ها اجرا شدند."
}

cmd_seed() {
  require_root
  local release
  release="$(current_release)"
  run_cli_script "$release" seed "$@"
  ok "داده‌های اولیه/کاتالوگ به‌روزرسانی شد."
}

cmd_reset_admin() {
  require_root
  local release
  release="$(current_release)"
  command -v psql >/dev/null 2>&1 || die "psql در دسترس نیست."
  local username="${1:-admin}"
  log "تعیین رمز جدید برای مدیر کل «${username}»…"
  run_cli_script "$release" reset-password --username "$username" --generate --unlock
  warn "رمز نمایش‌داده‌شده فقط یک بار قابل مشاهده است. آن را در جای امن ذخیره کنید."
}

cmd_doctor() {
  heading "بررسی سلامت نصب"
  local problems=0
  is_installed && ok "نصب شناسایی شد: $(current_release)" || { err "نصب شناسایی نشد."; problems=$((problems + 1)); }

  [ -f "$ENV_FILE" ] && ok "فایل تنظیمات: $ENV_FILE" || { err "فایل تنظیمات وجود ندارد."; problems=$((problems + 1)); }
  if [ -f "$ENV_FILE" ]; then
    local perms
    perms="$(stat -c '%a' "$ENV_FILE")"
    if [ "$perms" = "640" ] || [ "$perms" = "600" ]; then ok "دسترسی فایل تنظیمات: $perms"; else warn "دسترسی فایل تنظیمات $perms است (بهتر است 640)."; fi
    if grep -qE '^APP_ENCRYPTION_KEY=.{32,}' "$ENV_FILE"; then ok "کلید رمزنگاری تنظیم شده است."; else err "APP_ENCRYPTION_KEY تنظیم نشده است؛ اعتبارنامه‌ها رمزنگاری نمی‌شوند."; problems=$((problems + 1)); fi
    if [ "$(read_env_value COOKIE_SECURE)" = "true" ]; then ok "کوکی نشست روی HTTPS محدود است."; else warn "COOKIE_SECURE=false است؛ در محیط عملیاتی با HTTPS باید true باشد."; fi
  fi

  service_active && ok "سرویس ${SERVICE_NAME} فعال است." || { err "سرویس ${SERVICE_NAME} فعال نیست."; problems=$((problems + 1)); }
  cmd_health >/dev/null 2>&1 && ok "API سالم است." || { err "API پاسخ سالم نمی‌دهد."; problems=$((problems + 1)); }

  if command -v psql >/dev/null 2>&1; then
    if PGPASSWORD="$(read_env_value DB_PASSWORD)" psql -h "$DB_HOST" -U "$DB_USER" -d "$DB_NAME" -tAc 'SELECT 1' >/dev/null 2>&1; then
      ok "اتصال به پایگاه داده برقرار است."
    else
      err "اتصال به پایگاه داده ناموفق بود."
      problems=$((problems + 1))
    fi
  fi

  if nginx -t >/dev/null 2>&1; then ok "پیکربندی Nginx معتبر است."; else warn "پیکربندی Nginx ایراد دارد."; fi
  if systemctl is-active --quiet pishkan-backup.timer; then ok "پشتیبان‌گیری خودکار فعال است."; else warn "پشتیبان‌گیری خودکار غیرفعال است."; fi

  local free_gb
  free_gb="$(df -Pm "$STATE_DIR" 2>/dev/null | awk 'NR==2 {printf "%d", $4/1024}')"
  if [ -n "$free_gb" ] && [ "$free_gb" -lt 2 ]; then warn "فضای دیسک کم است: ${free_gb}GB آزاد."; fi

  echo
  if [ "$problems" -eq 0 ]; then ok "همه بررسی‌ها بدون مشکل گذشتند."; else err "${problems} مورد نیازمند بررسی است."; exit 1; fi
}

# ---------------------------------------------------------------------------
# provision — re-apply deploy.conf to nginx, TLS and the API environment
#
# This is the command that makes the domain file authoritative. After editing
# DOMAIN, DOMAIN_WWW, DOMAIN_ALIASES, BLOG_MODE or BLOG_SUBDOMAIN, one
# `pishkan provision` rewrites nginx, expands the certificate and restarts the
# API so CORS and cookie settings follow. No reinstall, no data touched.
# ---------------------------------------------------------------------------

provision_render() {
  local template="$1" out="$2" server_name="$3" blog_block="$4" port="$5"
  local web_root="$6" acme="$7" listen="$8" ssl="$9" redirect="${10}"
  local content

  content="$(cat "$template")"
  content="${content//__LISTEN__/$listen}"
  content="${content//__SSL__/$ssl}"
  content="${content//__REDIRECT__/$redirect}"
  content="${content//__BLOG_REDIRECT__/$blog_block}"
  content="${content//__SERVER_NAME__/$server_name}"
  content="${content//__API_PORT__/$port}"
  content="${content//__WEB_ROOT__/$web_root}"
  content="${content//__ACME_ROOT__/$acme}"
  printf '%s\n' "$content" >"$out"
}

cmd_provision() {
  require_root
  local force_tls=0 arg
  while [ $# -gt 0 ]; do
    case "$1" in
      --tls) force_tls=1 ;;
      --dry-run) PROVISION_DRY_RUN=1 ;;
      *) die "پارامتر ناشناخته برای provision: $1" ;;
    esac
    shift
  done

  is_installed || die "Pishkan نصب نشده است. ابتدا نصب‌کننده را اجرا کنید."
  local deploy_file
  deploy_file="$(config_resolve_file)"
  [ -n "$deploy_file" ] || die "فایل deploy.conf پیدا نشد. آن را در ${CONFIG_DIR}/deploy.conf بسازید."
  config_load "$deploy_file" || die "خواندن ${deploy_file} ناموفق بود."

  heading "اعمال تنظیمات استقرار"
  ok "فایل: ${deploy_file}"

  if ! config_validate; then
    config_report
    die "تنظیمات معتبر نیست؛ هیچ تغییری اعمال نشد."
  fi
  config_report

  local domain tls_mode blog_sub cors app_url tls_hosts
  domain="$(config_get DOMAIN)"
  tls_mode="$(config_get TLS_MODE auto)"
  blog_sub="$(config_blog_subdomain || true)"
  cors="$(config_cors_origins)"
  app_url="$(config_app_url)"
  tls_hosts="$(config_tls_hosts)"
  [ "$force_tls" = "1" ] && tls_mode="auto"

  ok "دامنه: ${domain}"
  [ -n "$blog_sub" ] && ok "وبلاگ: ${blog_sub} (زیردامنه)"
  ok "CORS: ${cors}"

  if [ "${PROVISION_DRY_RUN:-0}" = "1" ]; then
    echo
    log "حالت آزمایشی — هیچ فایلی نوشته نشد. تغییرات زیر اعمال می‌شد:"
    log "  • nginx server_name: $(config_main_hosts)${blog_sub:+ $blog_sub}"
    log "  • گواهی برای: ${tls_hosts}"
    log "  • APP_URL=${app_url}"
    log "  • CORS_ORIGINS=${cors}"
    return 0
  fi

  # --- 1. environment file: the API must agree with nginx -------------------
  log "به‌روزرسانی تنظیمات API…"
  local changed=0
  if [ "$(read_env_value APP_URL)" != "$app_url" ]; then
    set_env_value APP_URL "$app_url"; set_env_value API_URL "$app_url"; changed=1
  fi
  if [ "$(read_env_value CORS_ORIGINS)" != "$cors" ]; then
    set_env_value CORS_ORIGINS "$cors"; changed=1
  fi
  local cookie_secure
  cookie_secure="$([ "$tls_mode" = "off" ] && echo false || echo true)"
  if [ "$(read_env_value COOKIE_SECURE)" != "$cookie_secure" ]; then
    set_env_value COOKIE_SECURE "$cookie_secure"; changed=1
  fi
  [ "$changed" = "1" ] && ok "تنظیمات API به‌روز شد." || ok "تنظیمات API از قبل هم‌راستا بود."

  # --- 2. nginx -------------------------------------------------------------
  log "بازنویسی پیکربندی Nginx…"
  local acme_root="/var/www/letsencrypt"
  install -d -m 0755 "${acme_root}/.well-known/acme-challenge"
  install -d -m 0755 /etc/nginx/snippets
  install -m 0644 "${CURRENT_LINK}/deploy/nginx/snippets/pishkan-proxy.conf" \
    /etc/nginx/snippets/pishkan-proxy.conf

  local main_hosts server_name blog_block=""
  main_hosts="$(config_main_hosts)"
  server_name="$main_hosts"
  if [ -n "$blog_sub" ]; then
    server_name="${main_hosts} ${blog_sub}"
    blog_block="    # The blog moved to its own hostname. Permanent redirects keep every
    # shared link and every indexed URL working.
    location ~ ^/blog(/.*)?\$ {
        return 301 https://${blog_sub}\$1;
    }
"
  fi

  local listen_http listen_tls ssl_lines redirect_lines
  listen_http="    listen 80;
    listen [::]:80;
"
  listen_tls="    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
"
  ssl_lines=""
  redirect_lines=""

  local cert_hosts="$(config_tls_hosts)" cert_primary
  cert_primary="$(config_get DOMAIN)"

  if [ "$tls_mode" != "off" ]; then
    local -a cert_args=()
    local host
    for host in $cert_hosts; do cert_args+=(-d "$host"); done
    log "گسترش/تمدید گواهی برای: ${cert_hosts}"
    if certbot certonly --nginx --cert-name "$cert_primary" "${cert_args[@]}" \
         --non-interactive --agree-tos --email "$(config_get ACME_EMAIL)" \
         --keep-until-expiring --expand >/dev/null 2>&1; then
      ok "گواهی آماده است."
      ssl_lines=""
      ssl_lines="${ssl_lines}    ssl_certificate     /etc/letsencrypt/live/${cert_primary}/fullchain.pem;
"
      ssl_lines="${ssl_lines}    ssl_certificate_key /etc/letsencrypt/live/${cert_primary}/privkey.pem;
"
      ssl_lines="${ssl_lines}    ssl_trusted_certificate /etc/letsencrypt/live/${cert_primary}/chain.pem;
"
      ssl_lines="${ssl_lines}    ssl_protocols TLSv1.2 TLSv1.3;
"
      ssl_lines="${ssl_lines}    ssl_prefer_server_ciphers off;
"
      ssl_lines="${ssl_lines}    ssl_session_cache shared:SSL:10m;
"
      ssl_lines="${ssl_lines}    ssl_session_timeout 1d;
"
      ssl_lines="${ssl_lines}    ssl_stapling on;
"
      ssl_lines="${ssl_lines}    ssl_stapling_verify on;
"
      ssl_lines="${ssl_lines}    add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;
"
      redirect_lines="    location / {
        return 301 https://\$host\$request_uri;
    }
"
    else
      warn "گواهی صادر نشد؛ سایت روی HTTP می‌ماند. DNS و پورت ۸۰ را بررسی کنید."
    fi
  fi

  local nginx_backup
  nginx_backup="$(mktemp -d)"
  cp -a /etc/nginx/sites-available/. "$nginx_backup/" 2>/dev/null || true

  provision_render "${CURRENT_LINK}/deploy/nginx/pishkan.conf" \
    "/etc/nginx/sites-available/${APP_NAME}.conf" \
    "$server_name" "$blog_block" "$(api_port)" \
    "${CURRENT_LINK}/apps/web/dist" "$acme_root" "$listen_http" "" ""

  ln -sfn "/etc/nginx/sites-available/${APP_NAME}.conf" "/etc/nginx/sites-enabled/${APP_NAME}.conf"
  rm -f /etc/nginx/sites-enabled/default

  if [ -n "$ssl_lines" ]; then
    provision_render "${CURRENT_LINK}/deploy/nginx/pishkan.conf" \
      "/etc/nginx/sites-available/${APP_NAME}-tls.conf" \
      "$server_name" "$blog_block" "$(api_port)" \
      "${CURRENT_LINK}/apps/web/dist" "$acme_root" "$listen_tls" "$ssl_lines" ""
    provision_render "${CURRENT_LINK}/deploy/nginx/pishkan.conf" \
      "/etc/nginx/sites-available/${APP_NAME}.conf" \
      "$server_name" "$blog_block" "$(api_port)" \
      "${CURRENT_LINK}/apps/web/dist" "$acme_root" "$listen_http" "" "$redirect_lines"
    ln -sfn "/etc/nginx/sites-available/${APP_NAME}-tls.conf" "/etc/nginx/sites-enabled/${APP_NAME}-tls.conf"
  else
    rm -f "/etc/nginx/sites-enabled/${APP_NAME}-tls.conf"
  fi

  if ! nginx -t >/dev/null 2>&1; then
    err "پیکربندی تازه معتبر نیست؛ به نسخه قبلی برمی‌گردیم."
    cp -a "${nginx_backup}/." /etc/nginx/sites-available/ 2>/dev/null || true
    rm -rf "$nginx_backup"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    die "تغییری اعمال نشد. برای دیدن خطا: nginx -t"
  fi
  rm -rf "$nginx_backup"
  systemctl reload nginx
  ok "Nginx بارگذاری شد."

  # --- 3. restart only if the environment actually changed ------------------
  if [ "$changed" = "1" ]; then
    log "راه‌اندازی مجدد API برای اعمال تنظیمات…"
    systemctl restart "$SERVICE_NAME"
    if wait_for_health 60; then
      ok "API سالم است."
    else
      err "API پس از تغییر تنظیمات پاسخ نداد."
      err "بررسی: journalctl -u ${SERVICE_NAME} -n 100 --no-pager"
      exit 1
    fi
  fi

  # --- 4. record what was applied -------------------------------------------
  if [ -f "$deploy_file" ] && [ "$deploy_file" = "${CONFIG_DIR}/deploy.conf" ]; then
    : # already the live file
  elif [ -f "$deploy_file" ]; then
    install -m 0640 "$deploy_file" "${CONFIG_DIR}/deploy.conf"
  fi

  echo
  ok "تنظیمات استقرار اعمال شد."
  ok "نشانی سامانه: ${app_url}"
}

# ---------------------------------------------------------------------------

CMD="${1:-help}"
shift || true

case "$CMD" in
  status)   require_root; cmd_status ;;
  health)   cmd_health ;;
  version)  cmd_version ;;
  logs)     require_root; cmd_logs "$@" ;;
  restart)  cmd_restart ;;
  update)   cmd_update "$@" ;;
  upgrade)  cmd_update "$@" ;;
  rollback) cmd_rollback "$@" ;;
  backup)   require_root; cmd_backup "$@" ;;
  restore)  cmd_restore "$@" ;;
  migrate)  cmd_migrate ;;
  seed)     cmd_seed "$@" ;;
  reset-admin) cmd_reset_admin "$@" ;;
  provision) require_root; cmd_provision "$@" ;;
  doctor)   require_root; cmd_doctor ;;
  help|-h|--help) usage ;;
  *) err "دستور ناشناخته: $CMD"; echo; usage; exit 1 ;;
esac
